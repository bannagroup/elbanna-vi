{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sync:functions": "node scripts/sync-functions.mjs",
    "check:functions": "node scripts/sync-functions.mjs --check",
    "test:sql": "bash tests/sql/run.sh",
    "test": "tsx --test tests/*.test.ts",
    "build:apk": "vite build --mode requests && cap sync android",
    "dev:driver": "vite --port=3001 --host=0.0.0.0 --mode driver",
    "build:driver": "vite build --mode driver",
    "build:driver-apk": "cp capacitor.driver.config.ts capacitor.config.ts && vite build --mode driver && cap sync android",
    "dev:licenses": "vite --port=3002 --host=0.0.0.0 --mode licenses",
    "build:licenses": "vite build --mode licenses",
    "build:licenses-apk": "cp capacitor.licenses.config.ts capacitor.config.ts && vite build --mode licenses && cap sync android"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@capacitor/cli": "^7.4.0"
  }
}